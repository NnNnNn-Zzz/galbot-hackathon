{
  "name": "medicine.expiry_demo",
  "description": "示例升级版：把 grasp 换成「读日期 → 判过期 → 选最左的过期盒 → 夹取」。只有 grasp 这一步和 baseline 不同",
  "version": 2,
  "steps": [
    {
      "id": "preflight",
      "stage": "preflight",
      "non_fatal": true
    },
    {
      "id": "grasp",
      "stage": "grasp_expired_box",
      "params": {
        "chain": "left_arm",
        "tool": "galbot_gripper",
        "prefer": "leftmost"
      }
    },
    {
      "id": "announce",
      "stage": "announce"
    },
    {
      "id": "shift_left",
      "stage": "shift_left",
      "params": {
        "distance_m": 0.5
      }
    },
    {
      "id": "turn_bin",
      "stage": "turn",
      "params": {
        "deg_key": "bin_turn_deg",
        "default_deg": -30.0,
        "label": "右转"
      }
    },
    {
      "id": "drop",
      "stage": "drop"
    },
    {
      "id": "home",
      "stage": "return_home",
      "must_run": true,
      "non_fatal": true
    }
  ]
}
