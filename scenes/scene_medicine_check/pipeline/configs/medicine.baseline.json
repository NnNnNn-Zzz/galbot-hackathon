{
  "name": "medicine.baseline",
  "description": "基线：桌面最左（第一盒）药 → 播报 → 转身 180° → 直行 3m → 右转 30° → 投放 → 归位",
  "version": 2,
  "steps": [
    {
      "id": "preflight",
      "stage": "preflight",
      "non_fatal": true
    },
    {
      "id": "grasp",
      "stage": "grasp_first_box",
      "params": {
        "chain": "left_arm",
        "tool": "galbot_gripper"
      }
    },
    {
      "id": "announce",
      "stage": "announce"
    },
    {
      "id": "turn_around",
      "stage": "turn",
      "params": {
        "deg_key": "turn_deg",
        "default_deg": 180.0,
        "label": "转身"
      }
    },
    {
      "id": "drive",
      "stage": "drive"
    },
    {
      "id": "turn_bin",
      "stage": "turn",
      "params": {
        "deg_key": "bin_turn_deg",
        "default_deg": -30.0,
        "label": "右转"
      }
    },
    {
      "id": "drop",
      "stage": "drop"
    },
    {
      "id": "home",
      "stage": "return_home",
      "must_run": true,
      "non_fatal": true
    }
  ]
}
