{
  "name": "medicine.baseline",
  "description": "基线：桌面最左（第一盒）药 → 播报 → 左移 0.5m → 右转 30° → 投放 → 归位",
  "version": 4,
  "steps": [
    {
      "id": "preflight",
      "stage": "preflight",
      "non_fatal": true
    },
    {
      "id": "init_pose",
      "stage": "initialize_pose"
    },
    {
      "id": "grasp",
      "stage": "grasp_first_box",
      "params": {
        "chain": "right_arm",
        "tool": "galbot_gripper"
      }
    },
    {
      "id": "announce",
      "stage": "announce"
    },
    {
      "id": "shift_left",
      "stage": "shift_left",
      "params": {
        "distance_m": 0.5
      }
    },
    {
      "id": "turn_bin",
      "stage": "turn",
      "params": {
        "deg_key": "bin_turn_deg",
        "default_deg": -30.0,
        "label": "右转"
      }
    },
    {
      "id": "drop",
      "stage": "drop"
    },
    {
      "id": "home",
      "stage": "return_home",
      "must_run": true,
      "non_fatal": true
    }
  ]
}
